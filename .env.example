# SS Trading Management System - Server Environment Variables
PORT=5000
NODE_ENV=development

# Application Base URL (Optional: used for public WhatsApp bill links, e.g. https://your-domain.com. Defaults to request host header)
# APP_URL=http://localhost:5000

# MySQL 8.x Database Configuration
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Alternative: Single Database Connection URI (DATABASE_URL or MYSQL_URL)
# DATABASE_URL=mysql://user:password@hostname:3306/database_name

# MySQL Connection Pool Settings (Optional)
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=10
DB_IDLE_TIMEOUT=60000
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=10000

# SSL / TLS Settings (for Cloud-Hosted MySQL: AWS RDS, DigitalOcean, Azure, PlanetScale, etc.)
# Set DB_SSL=true when connecting to a remote cloud MySQL instance requiring SSL/TLS
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_PATH=certs/ca.pem
# DB_SSL_CA=   # Optional: paste entire PEM content directly here

# JWT Authentication & Mobile Session (365d = 1 year persistent session for client)
JWT_SECRET=your_jwt_super_secret_key_here
JWT_EXPIRES_IN=365d

# AWS S3 Settings (Leave empty to use local file storage in /uploads/bills)
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
